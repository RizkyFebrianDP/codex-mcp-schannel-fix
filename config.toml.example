# Example configuration for ~/.codex/config.toml
# Workaround for Windows Schannel TLS issues with remote MCP servers

[mcp_servers.enterprise-mcp]
command = "C:\\Program Files\\nodejs\\node.exe"
args = [
  "C:\\Users\\<Username>\\.codex\\mcp-runtimes\\common\\node_modules\\mcp-remote\\dist\\proxy.js",
  "https://mcp.internal-company.com/v1/gateway/mcp-server",
  "--header",
  "Authorization: Bearer <YOUR_BEARER_TOKEN>"
]
enabled = true
startup_timeout_sec = 60

[mcp_servers.enterprise-mcp.env]
NODE_TLS_REJECT_UNAUTHORIZED = "0"

# Optional: Additional microservices can be bridged similarly
# [mcp_servers.custom-service]
# command = "C:\\Program Files\\nodejs\\node.exe"
# args = [
#   "C:\\Users\\<Username>\\.codex\\mcp-runtimes\\common\\node_modules\\mcp-remote\\dist\\proxy.js",
